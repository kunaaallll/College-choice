// College Choice — database schema
// Engine: PostgreSQL. ORM: Prisma.
// Run `prisma migrate dev` to create/update tables, then `prisma db seed`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Taxonomy
// ─────────────────────────────────────────────────────────────

model Stream {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  slug          String    @unique
  initial       String // 2-letter badge, e.g. "En"
  colorGradient String // CSS gradient used by the UI badge
  description   String?
  avgFees       String? // display label, e.g. "₹2–8 L"
  degrees       String[] // e.g. ["B.Tech","M.Tech","B.E."]
  examName      String? // headline exam label, e.g. "JEE Main"
  collegeCount  Int       @default(0)
  colleges      College[]
  categories    Category[] // specialisations under this stream
  entries       ContentEntry[]

  @@index([slug])
}

model City {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  slug         String    @unique
  state        String?
  imageUrl     String?
  collegeCount Int       @default(0)
  colleges     College[]

  @@index([slug])
  @@index([state])
}

model Exam {
  id       Int           @id @default(autoincrement())
  name     String        @unique // "JEE Main"
  slug     String        @unique
  fullName String // "Joint Entrance Examination"
  level    String // National | University | State
  date     String // display date, e.g. "Jan 24, 2026"
  examOn   DateTime? // machine-readable date for sorting
  mode     String // Online | Offline
  stream   String // headline stream label
  colleges CollegeExam[]
  entry    ContentEntry? // editorial exam page (/exams/<slug>)

  @@index([slug])
}

// ─────────────────────────────────────────────────────────────
// College & its owned detail records
// ─────────────────────────────────────────────────────────────

enum CollegeType {
  Public
  Private
  Government
  Deemed
  Autonomous
}

enum CollegeMode {
  Campus // traditional on-campus college (default)
  Online // 100% online degree (UGC-DEB approved online mode)
  Distance // distance / correspondence mode
  Hybrid // blended
}

model College {
  id           Int          @id @default(autoincrement())
  name         String
  slug         String       @unique
  location     String // "Mumbai, Maharashtra"
  state        String? // "Maharashtra" — denormalised for landing pages & filters
  type         CollegeType?
  mode         CollegeMode  @default(Campus) // Campus | Online | Distance | Hybrid
  approvals    String[] // accreditations/approvals, e.g. ["UGC-DEB","NAAC A+","AICTE","WES"]
  // Curated/ranking fields — nullable because bulk-imported colleges may lack them
  rank         Int? // editorial/stream rank used for "top ranked" ordering
  nirfRank     Int? // official NIRF overall rank, if listed
  rating       Float?
  reviewsLabel String? // "2.4k" (display); reviewsCount for math
  reviewsCount Int          @default(0)
  feesNum      Int? // numeric total fees in ₹ (for filtering/sorting)
  feesLabel    String? // "₹2.30 L" (display)
  packageLabel String? // "₹21.8 LPA"
  examName     String? // headline exam label shown on cards, e.g. "JEE Adv"
  estd         Int?
  imgUrl       String?
  logoUrl      String?
  sampleDegreeUrl String? // uploaded sample-degree photo, shown on the Placements tab (online colleges)
  about        String? // short summary (cards / meta fallback)

  // ── SEO / detailed content ──────────────────────────────
  descriptionLong String? @db.Text // full, indexable description shown on the detail page
  metaTitle       String? // <title> override
  metaDescription String? // meta description override
  website         String?
  affiliation     String? // affiliating university/board
  approvedBy      String? // UGC / AICTE / MCI etc.
  latitude        Float?
  longitude       Float?

  // ── Provenance (open-data ingestion) ────────────────────
  source       String? // "NIRF" | "AICTE" | "UGC" | "csv:filename" | "manual"
  sourceUrl    String?
  lastSyncedAt DateTime?
  published    Boolean   @default(true)
  featured     Boolean   @default(false) // hand-picked colleges surfaced on landing pages

  streamId Int
  stream   Stream @relation(fields: [streamId], references: [id])
  cityId   Int
  city     City   @relation(fields: [cityId], references: [id])

  courses      Course[]
  highlights   Highlight[]
  reviews      Review[]
  ratingBars   RatingBar[]
  gallery      GalleryImage[]
  placement    Placement?
  recruiters   CollegeRecruiter[]
  exams        CollegeExam[]
  faqs         Faq[]
  sections     ContentSection[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([streamId])
  @@index([cityId])
  @@index([state])
  @@index([rank])
  @@index([feesNum])
  @@index([published])
  @@index([mode])
  @@index([featured])
  // Composite index powering programmatic landing pages (stream-in-state/city)
  @@index([streamId, state])
}

// Rich editorial content for the tabbed college detail pages (KollegeApply-style).
// One row = one titled section of markdown under a tab. Tabs: info | courses-fees |
// admissions | placements | cutoffs | scholarships | rankings | hostel
model ContentSection {
  id        Int     @id @default(autoincrement())
  collegeId Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  tab       String
  heading   String
  body      String  @db.Text // markdown: paragraphs, **bold**, - lists, | tables |
  sort      Int     @default(0)

  @@index([collegeId, tab])
}

// FAQs power the FAQPage JSON-LD on each college page (rich results in Google).
model Faq {
  id        Int     @id @default(autoincrement())
  collegeId Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  question  String
  answer    String  @db.Text
  sort      Int     @default(0)

  @@index([collegeId])
}

model Course {
  id        Int     @id @default(autoincrement())
  collegeId Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name      String
  duration  String
  seats     String
  feesLabel String

  @@index([collegeId])
}

model Highlight {
  id        Int     @id @default(autoincrement())
  collegeId Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  text      String

  @@index([collegeId])
}

model Review {
  id        Int      @id @default(autoincrement())
  collegeId Int
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  authorName String
  initial   String
  color     String
  meta      String // "B.Tech CSE · 2025"
  stars     Float
  text      String
  createdAt DateTime @default(now())

  @@index([collegeId])
}

model RatingBar {
  id        Int     @id @default(autoincrement())
  collegeId Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  label     String // Academics | Faculty | ...
  pct       Int // 0-100

  @@index([collegeId])
}

model Placement {
  id             Int     @id @default(autoincrement())
  collegeId      Int     @unique
  college        College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  avgPackage     String
  highestPackage String
  placedPct      String
}

model GalleryImage {
  id        Int     @id @default(autoincrement())
  collegeId Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  url       String
  alt       String? // image SEO; falls back to the college name
  sort      Int     @default(0)

  @@index([collegeId])
}

model Recruiter {
  id       Int                @id @default(autoincrement())
  name     String             @unique
  colleges CollegeRecruiter[]
}

model CollegeRecruiter {
  collegeId   Int
  recruiterId Int
  college     College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  recruiter   Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@id([collegeId, recruiterId])
}

model CollegeExam {
  collegeId Int
  examId    Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([collegeId, examId])
}

// ─────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────

// Editorial workflow: DRAFT → IN_REVIEW → PUBLISHED (optionally scheduled via
// publishAt, expiring at unpublishAt) → UNPUBLISHED.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  UNPUBLISHED
}

model NewsArticle {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  category  String // Admissions | Results | Counselling | ...
  title     String
  excerpt   String
  body      String?
  date      String // display date
  publishedAt DateTime @default(now()) // sort/feed date
  readTime  String // "4 min read"
  imgUrl    String?

  // ── Workflow ──
  status      ContentStatus @default(PUBLISHED)
  publishAt   DateTime? // go live at (scheduled); null = immediately
  unpublishAt DateTime? // expire at; null = never
  pendingData Json? // edits to a live article awaiting approval
  reviewNote  String? // reviewer feedback ("request changes")
  authorId    Int?
  updatedById Int?
  updatedAt   DateTime  @default(now()) @updatedAt
  tags        NewsTag[]

  @@index([slug])
  @@index([category])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Editorial content types: course pages, exam pages, info/service pages
// ─────────────────────────────────────────────────────────────

enum EntryType {
  COURSE // /courses/<slug>
  EXAM // /exams/<slug> (linked to an Exam)
  PAGE // /<slug>  (services, counselling, policies…)
}

model ContentEntry {
  id         Int           @id @default(autoincrement())
  type       EntryType
  slug       String
  title      String // the page H1
  summary    String? // intro under the H1; meta description fallback
  body       String?       @db.Text // sanitised HTML from the rich text editor
  data       Json? // type-specific fields (see api/src/lib/entries.ts)
  faqs       Json? // [{ question, answer }]
  heroImage  String?
  heroAlt    String?
  streamId   Int?
  stream     Stream?       @relation(fields: [streamId], references: [id], onDelete: SetNull)
  categoryId Int?
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  examId     Int?          @unique
  exam       Exam?         @relation(fields: [examId], references: [id], onDelete: SetNull)
  related    Json? // manual internal links: { colleges: id[], entries: id[], news: id[] }
  tags       EntryTag[]

  // ── Workflow (same rules as NewsArticle) ──
  status      ContentStatus @default(DRAFT)
  publishAt   DateTime?
  unpublishAt DateTime?
  pendingData Json?
  reviewNote  String?
  authorId    Int?
  updatedById Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@unique([type, slug])
  @@index([type, status])
}

// Category tree (with optional stream → specialisations) and free-form tags.
model Category {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  description String?
  parentId    Int?
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]     @relation("CategoryTree")
  streamId    Int?
  stream      Stream?        @relation(fields: [streamId], references: [id], onDelete: SetNull)
  sort        Int            @default(0)
  entries     ContentEntry[]
}

model Tag {
  id      Int        @id @default(autoincrement())
  name    String     @unique
  slug    String     @unique
  entries EntryTag[]
  news    NewsTag[]
}

model EntryTag {
  entryId Int
  tagId   Int
  entry   ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag     Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
}

model NewsTag {
  newsId Int
  tagId  Int
  news   NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag    Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
}

// Media library: uploaded files with image-SEO fields and generated WebP sizes.
model Media {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  filename    String // original file name
  mime        String
  size        Int
  width       Int?
  height      Int?
  alt         String?
  title       String?
  caption     String?
  description String?
  folder      String   @default("")
  variants    Json? // { "480": url, "960": url, "1600": url } (WebP)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([folder])
}

// ─────────────────────────────────────────────────────────────
// CMS users, audit trail & revisions
// ─────────────────────────────────────────────────────────────

enum AdminRole {
  ADMIN // everything, incl. users and settings
  SEO_MANAGER // all SEO, redirects, robots/sitemap, approves & publishes content
  CONTENT_EDITOR // creates/edits content, basic SEO fields, submits for approval
}

model AdminUser {
  id                 Int            @id @default(autoincrement())
  email              String         @unique
  name               String
  passwordHash       String
  role               AdminRole      @default(CONTENT_EDITOR)
  active             Boolean        @default(true)
  mustChangePassword Boolean        @default(false) // set for new users and admin resets
  totpSecret         String? // base32 secret for two-factor login
  totpEnabled        Boolean        @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt
  sessions           AdminSession[]
}

// Opaque bearer sessions (only a hash of the token is stored), so a sign-out,
// deactivation or password reset takes effect immediately.
model AdminSession {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique
  userId     Int
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  @@index([userId])
}

// Who changed what, when. Not linked by FK so entries outlive users.
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  userEmail  String?
  action     String // e.g. "news.publish", "seo.page.update", "auth.login"
  entityType String?
  entityId   String?
  summary    String
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entityType, entityId])
}

// Point-in-time snapshots of editable content, for history & restore.
model Revision {
  id         Int      @id @default(autoincrement())
  entityType String // "news" | "college" | "seo"
  entityId   String // article/college id, or the page path for "seo"
  data       Json
  summary    String?
  userId     Int?
  userEmail  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// SEO (managed from the admin SEO panel)
// ─────────────────────────────────────────────────────────────

// Per-URL SEO overrides. Keyed by site path ("/colleges/iit-bombay" — no domain,
// query or trailing slash). Empty fields fall back to the page's built-in defaults.
model SeoMeta {
  id                 Int      @id @default(autoincrement())
  path               String   @unique
  title              String?
  description        String?
  keyword            String? // primary / target keyword
  canonical          String? // absolute URL or site path; null → self-referencing
  noindex            Boolean  @default(false)
  nofollow           Boolean  @default(false)
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  twitterTitle       String?
  twitterDescription String?
  excludeFromSitemap Boolean  @default(false)
  disableSchema      Boolean  @default(false) // turn off the page's automatic JSON-LD
  customSchema       String?  @db.Text // extra JSON-LD (validated JSON object/array)
  urlLocked          Boolean  @default(false) // block slug changes on critical pages
  h1                 String? // visible page heading override
  breadcrumbLabel    String? // label for this page in breadcrumb trails
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([noindex])
  @@index([updatedAt])
}

// 301/302 redirects, applied by the web app's middleware.
model Redirect {
  id         Int       @id @default(autoincrement())
  fromPath   String    @unique
  toPath     String // site path or absolute URL
  statusCode Int       @default(301) // 301 | 302
  isPrefix   Boolean   @default(false) // also redirect everything under fromPath/…
  enabled    Boolean   @default(true)
  note       String?
  hits       Int       @default(0)
  lastHitAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// URLs that served the 404 page — for spotting broken links and adding redirects.
model NotFoundLog {
  id        Int      @id @default(autoincrement())
  path      String   @unique
  hits      Int      @default(1)
  referrer  String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  resolved  Boolean  @default(false)

  @@index([resolved, hits])
}

// Site-wide key/value settings (robots.txt, sitemap sections, …).
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Users & leads
// ─────────────────────────────────────────────────────────────

model User {
  id           Int           @id @default(autoincrement())
  name         String?
  email        String?       @unique
  phone        String?       @unique
  passwordHash String?
  googleId     String?       @unique
  createdAt    DateTime      @default(now())
  applications Application[]
}

enum ApplicationStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model Application {
  id              Int               @id @default(autoincrement())
  fullName        String
  mobile          String
  email           String
  city            String?
  courseInterested String?
  notes           String? // predictor-form context: marks/rank, category, state, gender etc.
  collegeName     String? // free-text snapshot at submit time
  collegeId       Int?
  college         College?          @relation(fields: [collegeId], references: [id])
  userId          Int?
  user            User?             @relation(fields: [userId], references: [id])
  status          ApplicationStatus @default(NEW)
  createdAt       DateTime          @default(now())

  @@index([collegeId])
  @@index([status])
}
